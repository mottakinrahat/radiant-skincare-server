NODE_ENV=development
PORT=5000
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Prisma / PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/techntrove?schema=public"

# JWT Secrets
JWT_SECRET=super_secret_jwt_key
EXPIRES_IN=30d
REFRESH_TOKEN_SECRET=super_secret_refresh_key
REFRESH_TOKEN_EXPIRES_IN=365d

# Password Reset
RESET_PASS_TOKEN=super_secret_reset_token
RESET_PASS_TOKEN_EXPIRES_IN=1h
RESET_PASS_LINK=http://localhost:3000/reset-password

# Email configuration (Nodemailer)
EMAIL=your-email@gmail.com
APP_PASSWORD=your-app-password

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# SSLCommerz Payment Gateway
STORE_ID=your_store_id
STORE_PASS=your_store_pass
IS_LIVE=false

# Steadfast Courier Gateway Credentials
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key

# Meta & TikTok Conversions API (CAPI) Tracking
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
TIKTOK_PIXEL_ID=
TIKTOK_ACCESS_TOKEN=

# FraudBD.com API Integration
FRAUD_BD_API_KEY=your_fraudbd_api_key_here
FRAUD_BD_BASE_URL=https://fraudbd.com
